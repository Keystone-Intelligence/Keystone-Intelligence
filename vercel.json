{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/pricing",
      "destination": "/how-it-works#pricing",
      "permanent": true
    },
    {
      "source": "/case-studies",
      "destination": "/industries",
      "permanent": true
    },
    {
      "source": "/blog/blog-:slug",
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/blog/blog-:slug.html",
      "destination": "/blog/:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}